{
  "name": "nonstopmaker-lite",
  "version": "1.0.0",
  "description": "Offline DJ set builder with local BPM/key analysis and MP3 rendering.",
  "author": "NonstopMaker Lite",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "package:win": "npm run build:desktop && electron-builder --win nsis portable --publish never",
    "preview": "vite preview --host 0.0.0.0",
    "prepare:timemark-assets": "node scripts/copy-ocr-assets.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/roboto-condensed": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/vie": "^1.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.nonstopmaker.lite",
    "productName": "NonstopMaker Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "NonstopMaker-Lite-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "NonstopMaker-Lite-${version}-portable-${arch}.${ext}"
    }
  }
}
